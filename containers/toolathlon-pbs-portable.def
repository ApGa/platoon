Bootstrap: localimage
From: BASE_SIF_PATH

%labels
    org.opencontainers.image.source https://github.com/ApGa/toolathlon-gym
    org.opencontainers.image.revision 18e62c0d0419da88209af911528f2f8a0b44a5ed
    org.openreward.toolathlon.base-sif-sha256 e730e11d1abc63f5cac9eb1788e36da79aa9c7027ed89d91ee42a5b1e311e267
    org.openreward.toolathlon.base-oci-digest sha256:c1e60b3673c848b758bda1b32ec39898feb5d6ff4c7e55ead8661adb04b327bd
    org.openreward.toolathlon.pbs-portability PATCH_IDENTITY
    org.openreward.toolathlon.playwright-browsers-sha256 84d979d1a301e24d7ee04009ff85b806cda195cce9d6bd1a8a686f06887805e5

%files
    patch_toolathlon_pbs_portable.py /usr/local/libexec/openreward/patch_toolathlon_pbs_portable.py
    repair_toolathlon_snowflake_catalog.py /usr/local/libexec/openreward/repair_toolathlon_snowflake_catalog.py
    launch_toolathlon_python_mcp.py /usr/local/libexec/openreward/launch_toolathlon_python_mcp.py
    probe_toolathlon_python_mcp_launchers.py /usr/local/libexec/openreward/probe_toolathlon_python_mcp_launchers.py
    verify_toolathlon_pbs_portability.sh /usr/local/libexec/openreward/verify_toolathlon_pbs_portability.sh

%post
    set -eu
    export PATH="/opt/venv/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin"
    export UV_PYTHON_INSTALL_DIR="/opt/uv/python"
    export UV_PYTHON_PREFERENCE="only-managed"
    export UV_PYTHON_DOWNLOADS="never"
    export UV_CACHE_DIR="/tmp/openreward-uv-cache"
    export PLAYWRIGHT_BROWSERS_PATH="/opt/ms-playwright"
    python3 /usr/local/libexec/openreward/patch_toolathlon_pbs_portable.py \
        --identity PATCH_IDENTITY
    python3 /usr/local/libexec/openreward/repair_toolathlon_snowflake_catalog.py
    # Singularity preserves the canonical checkout's umask-derived 0750 file
    # modes in %files.  Normalize every embedded provenance path after the
    # patcher has also created its sealed manifest, and before either the image
    # test or submitting uid executes/reads those paths.
    for directory in \
        /usr \
        /usr/local \
        /usr/local/libexec \
        /usr/local/libexec/openreward \
        /usr/local/share \
        /usr/local/share/openreward; do
        test -d "${directory}"
        test ! -L "${directory}"
        chown 0:0 "${directory}"
        chmod 0755 "${directory}"
        test "$(stat -c %u:%g "${directory}")" = 0:0
        test "$(stat -c %a "${directory}")" = 755
    done
    for asset in \
        /usr/local/libexec/openreward/patch_toolathlon_pbs_portable.py \
        /usr/local/libexec/openreward/repair_toolathlon_snowflake_catalog.py; do
        test -f "${asset}"
        test ! -L "${asset}"
        chown 0:0 "${asset}"
        chmod 0644 "${asset}"
        test "$(stat -c %u:%g "${asset}")" = 0:0
        test "$(stat -c %a "${asset}")" = 644
    done
    for executable in \
        /usr/local/libexec/openreward/launch_toolathlon_python_mcp.py \
        /usr/local/libexec/openreward/probe_toolathlon_python_mcp_launchers.py \
        /usr/local/libexec/openreward/verify_toolathlon_pbs_portability.sh; do
        test -f "${executable}"
        test ! -L "${executable}"
        chown 0:0 "${executable}"
        chmod 0755 "${executable}"
        test "$(stat -c %u:%g "${executable}")" = 0:0
        test "$(stat -c %a "${executable}")" = 755
    done
    manifest=/usr/local/share/openreward/toolathlon-pbs-portable.json
    test -f "${manifest}"
    test ! -L "${manifest}"
    chown 0:0 "${manifest}"
    chmod 0444 "${manifest}"
    test "$(stat -c %u:%g "${manifest}")" = 0:0
    test "$(stat -c %a "${manifest}")" = 444
    /usr/local/libexec/openreward/verify_toolathlon_pbs_portability.sh --structural-only

%environment
    export PATH="/opt/venv/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin"
    export UV_PYTHON_INSTALL_DIR="/opt/uv/python"
    export UV_PYTHON_PREFERENCE="only-managed"
    export UV_PYTHON_DOWNLOADS="never"
    export UV_CACHE_DIR="/tmp/openreward-uv-cache"
    export PLAYWRIGHT_BROWSERS_PATH="/opt/ms-playwright"

%test
    set -eu
    /usr/local/libexec/openreward/verify_toolathlon_pbs_portability.sh --structural-only
