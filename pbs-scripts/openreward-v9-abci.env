#!/usr/bin/env bash
# Non-secret release overlay for the PBS-portable Toolathlon v9 wave.
#
# This file is deliberately fail-closed until the rebuilt SIF has passed the
# one-node all-MCP health gate.  The PENDING path/hash are impossible launch
# identities and must be replaced together with the v9 release manifest.

set -euo pipefail
set +x

SITE_ABCI_ENV=/home/aci18912it/rasp/config/abci.env
[[ -r "${SITE_ABCI_ENV}" ]] || {
    echo "[openreward-v9-env] ERROR: site environment is unreadable: ${SITE_ABCI_ENV}" >&2
    return 2 2>/dev/null || exit 2
}
[[ "$(readlink -f "${SITE_ABCI_ENV}")" == "${SITE_ABCI_ENV}" ]] || {
    echo "[openreward-v9-env] ERROR: site environment must be the canonical path: ${SITE_ABCI_ENV}" >&2
    return 2 2>/dev/null || exit 2
}
# shellcheck disable=SC1090
source "${SITE_ABCI_ENV}"

export PLATOON_REPO_ROOT=/home/aci18912it/rasp/releases/platoon-v8r3-376d1b9-18e62c0
export PLATOON_CONTAINER_RUNTIME=/usr/bin/singularity
export OPENREWARD_TOOLATHLON_SIF=/groups/gai51740/aci18912it/rasp/images/PENDING-openreward-toolathlon-18e62c0d-pbs-portable.sif
export OPENREWARD_TOOLATHLON_SIF_SHA256=PENDING_TOOLATHLON_SIF_SHA256
export OPENREWARD_TOOLATHLON_BUILD_RECEIPT=/groups/gai51740/aci18912it/rasp/images/PENDING-openreward-toolathlon-18e62c0d-pbs-portable.sif.build-receipt.json
export OPENREWARD_TOOLATHLON_SOURCE_REVISION=18e62c0d0419da88209af911528f2f8a0b44a5ed
export OPENREWARD_TOOLATHLON_SOURCE_URL=https://github.com/ApGa/toolathlon-gym
export OPENREWARD_TOOLATHLON_OCI_AMD64_DIGEST=sha256:c1e60b3673c848b758bda1b32ec39898feb5d6ff4c7e55ead8661adb04b327bd
export OPENREWARD_TOOLATHLON_BASE_SIF_SHA256=e730e11d1abc63f5cac9eb1788e36da79aa9c7027ed89d91ee42a5b1e311e267
export OPENREWARD_TOOLATHLON_PORTABILITY_PATCH_SHA256=5c59374cceada9c3947f23a305323e73fe954a67b6763c8ee0fb7502d0975071
export OPENREWARD_TOOLATHLON_PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
export SWE_REBENCH_SOURCE_REVISION=538b5c5c9c529d3c78d5ef7fd3df7e54e7902ad7
export OPENREWARD_VERIFY_PINNED_SWE_RUNTIME=1
