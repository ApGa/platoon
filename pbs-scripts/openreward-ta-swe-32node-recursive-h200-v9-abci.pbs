#!/bin/bash
#PBS -P gai51740
#PBS -q R9920261300
#PBS -v RTYPE=rt_HF
#PBS -l select=32:mpiprocs=8
#PBS -l place=scatter
#PBS -l walltime=168:00:00
#PBS -N rasp-h200-32q38-rs5-v16
#PBS -j oe
#PBS -o /groups/gai51740/aci18912it/rasp/logs/
#PBS -m a

# Exact step-5 recovery of the dense-Qwen3.8 32-node recursive lineage created
# by PBS job 2154492.pbs1.  The experiment, trial, checkpoint and W&B lineage
# remain unchanged; only this PBS job name and its isolated success receipt are
# new.  Launch remains gated on the immutable v8r19 release, strict checkpoint
# authorization, and the PBS all-MCP health acceptance wave. Submitters must pass
# OPENREWARD_V9_GATE2_RESULT=/absolute/path/to/RESULT and
# OPENREWARD_TOOLATHLON_ALL_MCP_HEALTH_RESULT=/absolute/path/to/RESULT.

set -euo pipefail
umask 077

REPO_ROOT=/home/aci18912it/rasp/releases/platoon-v8r19-376d1b9-18e62c0
RELEASE_REF=refs/tags/abci-v8r19-376d1b9-18e62c0
RELEASE_VERIFY=${REPO_ROOT}/pbs-scripts/verify_openreward_v9_release.py
GATE2_VERIFY=${REPO_ROOT}/pbs-scripts/verify_openreward_v9_gate2_result.py
ALL_MCP_VERIFY=${REPO_ROOT}/pbs-scripts/verify_toolathlon_all_mcp_health_result.py
RESUME_VERIFY=${REPO_ROOT}/pbs-scripts/verify_openreward_resume_checkpoint.py
GATE2_RESULT=${OPENREWARD_V9_GATE2_RESULT:-}
ALL_MCP_RESULT=${OPENREWARD_TOOLATHLON_ALL_MCP_HEALTH_RESULT:-}
CONFIG=${REPO_ROOT}/plugins/openreward/platoon/openreward/configs/areal/abci_toolathlon_swe_openhands_areal_prealloc_32node_recursive_h200_qwen38_dense_c24_ta20_v16.yaml
COMMON=${REPO_ROOT}/pbs-scripts/openreward-ta-swe-prealloc-common.sh
ABCI_ENV=${REPO_ROOT}/pbs-scripts/openreward-v9-abci.env
EXPERIMENT=abci-or-ta-swe32-q38-v16
TRIAL=abci-ta-swe32-rec-q38d-c24-v16-t0
RECEIPT=/groups/gai51740/aci18912it/rasp/job-state/gates/${TRIAL}.resume-gs5-v8r16.success.json
CHECKPOINT_ROOT=/groups/gai51740/aci18912it/rasp/experiments/areal/checkpoints/aci18912it/abci-or-ta-swe32-q38-v16/abci-ta-swe32-rec-q38d-c24-v16-t0
SOURCE_CANDIDATE=/groups/gai51740/aci18912it/rasp/job-state/gates/${TRIAL}.success.candidate.json
SOURCE_RELEASE_ROOT=/home/aci18912it/rasp/releases/platoon-v8r13-376d1b9-18e62c0
SOURCE_RELEASE_REF=refs/tags/abci-v8r13-376d1b9-18e62c0
SOURCE_CONFIG_RELATIVE=plugins/openreward/platoon/openreward/configs/areal/abci_toolathlon_swe_openhands_areal_prealloc_32node_recursive_h200_qwen38_dense_c24_ta20_v16.yaml

[[ -d "${REPO_ROOT}/platoon" && -r "${CONFIG}" && -x "${COMMON}" && -r "${ABCI_ENV}" && \
    -x "${RELEASE_VERIFY}" && -x "${GATE2_VERIFY}" && -x "${ALL_MCP_VERIFY}" && \
    -x "${RESUME_VERIFY}" ]] || {
    echo "[h200-32-v9] ERROR: immutable v8r19 release is incomplete: ${REPO_ROOT}" >&2
    exit 2
}
[[ "$(grep -Fxc '  dynamic_batch_recollection_max_rounds: 2' "${CONFIG}")" == 1 && \
    "$(grep -Fxc '  consumer_batch_size: 16' "${CONFIG}")" == 1 && \
    "$(grep -Fxc '  max_head_offpolicyness: 1' "${CONFIG}")" == 1 && \
    "$(grep -Fxc '  backend: megatron:d20p2t4c1' "${CONFIG}")" == 1 && \
    "$(grep -Fxc '  backend: sglang:d12p1t8' "${CONFIG}")" == 1 && \
    "$(grep -Fxc '    n_mbs: 8' "${CONFIG}")" == 1 && \
    "$(grep -Fxc '  return_routed_experts: false' "${CONFIG}")" == 1 && \
    "$(grep -Fxc '  enable_router_replay: false' "${CONFIG}")" == 2 && \
    "$(grep -Fxc '    use_deterministic_algorithms: false' "${CONFIG}")" == 1 ]] || {
    echo "[h200-32-v9] ERROR: dense leaf must pin d20p2t4c1/d12p1t8, n_mbs=8, recollection=2, consumer=16, staleness=1, R3 off, and deterministic algorithms off" >&2
    exit 2
}
[[ "$(readlink -f "${REPO_ROOT}")" == "${REPO_ROOT}" ]] || {
    echo "[h200-32-v9] ERROR: release root must be the exact non-symlink path: ${REPO_ROOT}" >&2
    exit 2
}
release_head=$(git -C "${REPO_ROOT}" rev-parse --verify HEAD)
release_commit=$(git -C "${REPO_ROOT}" rev-parse --verify "${RELEASE_REF}^{commit}")
[[ "${release_head}" == "${release_commit}" ]] || {
    echo "[h200-32-v9] ERROR: release HEAD is not the pinned ${RELEASE_REF}" >&2
    exit 2
}
git -C "${REPO_ROOT}" diff --quiet --no-ext-diff HEAD -- || {
    echo "[h200-32-v9] ERROR: release tracked content differs from ${release_commit}" >&2
    exit 2
}
git -C "${REPO_ROOT}" diff --cached --quiet --no-ext-diff HEAD -- || {
    echo "[h200-32-v9] ERROR: release index differs from ${release_commit}" >&2
    exit 2
}
[[ -z "$(git -C "${REPO_ROOT}" status --porcelain=v1 --untracked-files=all)" ]] || {
    echo "[h200-32-v9] ERROR: release has tracked or ordinary untracked changes" >&2
    exit 2
}
# Load the exact release overlay before Gate2 verification because that gate
# binds the currently selected training SIF, repaired Toolathlon SIF, build
# receipt and portability identity.  The overlay does not print credentials.
# shellcheck disable=SC1090
export OPENREWARD_MODEL_FAMILY=qwen38
source "${ABCI_ENV}"
export PLATOON_ABCI_ENV_FILE=${ABCI_ENV}
[[ "${PLATOON_REPO_ROOT}" == "${REPO_ROOT}" ]] || {
    echo "[h200-32-v9] ERROR: v9 overlay selected another repository" >&2
    exit 2
}
[[ "${OPENREWARD_QWEN38_MODEL_REPOSITORY:-}" == apurvaga/Qwen3.8-27B-preserve-thinking && \
    "${OPENREWARD_QWEN38_MODEL_REVISION:-}" == 97c725615b8aa025b800da4ceed38811358b30f1 && \
    "${OPENREWARD_QWEN38_UPSTREAM_SOURCE:-}" == Qwen/Qwen3.8-27B@1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0 && \
    "${OPENREWARD_QWEN38_MODEL_SNAPSHOT:-}" == /groups/gai51740/aci18912it/rasp/cache/huggingface/hub/models--apurvaga--Qwen3.8-27B-preserve-thinking/snapshots/97c725615b8aa025b800da4ceed38811358b30f1 && \
    -d "${OPENREWARD_QWEN38_MODEL_SNAPSHOT}" && ! -L "${OPENREWARD_QWEN38_MODEL_SNAPSHOT}" && \
    "$(readlink -f "${OPENREWARD_QWEN38_MODEL_SNAPSHOT}")" == "${OPENREWARD_QWEN38_MODEL_SNAPSHOT}" ]] || {
    echo "[h200-32-v9] ERROR: v16 Qwen3.8 preserve-thinking model binding is incomplete" >&2
    exit 2
}
export PLATOON_MODEL_SNAPSHOT=${OPENREWARD_QWEN38_MODEL_SNAPSHOT}
"${RELEASE_VERIFY}" --release-root "${REPO_ROOT}"
[[ "${GATE2_RESULT}" == /* && -f "${GATE2_RESULT}" && ! -L "${GATE2_RESULT}" ]] || {
    echo "[h200-32-v9] ERROR: submission must pass one absolute final v9 Gate2 RESULT" >&2
    exit 2
}
"${GATE2_VERIFY}" --release-root "${REPO_ROOT}" --result "${GATE2_RESULT}"
[[ "${ALL_MCP_RESULT}" == /* && -f "${ALL_MCP_RESULT}" && ! -L "${ALL_MCP_RESULT}" ]] || {
    echo "[h200-32-v9] ERROR: submission must pass one absolute final all-MCP RESULT" >&2
    exit 2
}
"${ALL_MCP_VERIFY}" --release-root "${REPO_ROOT}" --result "${ALL_MCP_RESULT}" \
    --gate2-result "${GATE2_RESULT}"
echo "[h200-32-v9] accepted gate2=${GATE2_RESULT} all-MCP=${ALL_MCP_RESULT}"
unset release_head release_commit

"${RESUME_VERIFY}" \
    --checkpoint-root "${CHECKPOINT_ROOT}" \
    --expected-checkpoint-root "${CHECKPOINT_ROOT}" \
    --expected-global-step 5 \
    --expected-steps-per-epoch 846 \
    --expected-shards 160 \
    --expected-total-bytes 383216730907 \
    --expected-checkpoint-layout-sha256 6699027815f1628a6522c0520d3e30b17df124a41e3583b6ff4a3e4937b556f8 \
    --expected-checkpoint-sample-manifest-sha256 23aea8bf8cc932936d250dd1646d191efe664047169445da1ce2ef67d7168e11 \
    --expected-fixed-content-sha256 ff7dccef8552800b23f1888cbf646c9b8f8c9019f5e83831264cd75ad6a15e6d \
    --expected-recover-info-content-sha256 86e7b2726bcbc86328deb65dae0544c30afec2664d548b349aa87224626cfd3c \
    --expected-experiment "${EXPERIMENT}" \
    --expected-trial "${TRIAL}" \
    --current-config "${CONFIG}" \
    --expected-config-sha256 a3f8c04b2a3e59edd708f4f3a39eb38e1a22fa72b63a1f962afb54ac80183ffa \
    --source-candidate "${SOURCE_CANDIDATE}" \
    --expected-source-candidate-sha256 b432e3a12ff78921e7aac6cff3914f1c4c5aeffd9f08e3c9918ad5daa7714a22 \
    --source-pbs-job-id 2154492.pbs1 \
    --source-release-root "${SOURCE_RELEASE_ROOT}" \
    --source-release-ref "${SOURCE_RELEASE_REF}" \
    --source-config-relative "${SOURCE_CONFIG_RELATIVE}" \
    --model-repository "${OPENREWARD_QWEN38_MODEL_REPOSITORY}" \
    --model-revision "${OPENREWARD_QWEN38_MODEL_REVISION}" \
    --model-snapshot "${OPENREWARD_QWEN38_MODEL_SNAPSHOT}" \
    --target-receipt "${RECEIPT}"
echo "[h200-32-v9] authorized exact recovery checkpoint=${CHECKPOINT_ROOT} global_step=5"

export OPENREWARD_EXPECTED_NNODES=32
export OPENREWARD_EXPECTED_MODEL_SHARDS=18
export OPENREWARD_SERVICE_NODE_COUNT=12
export OPENREWARD_EXPECTED_RECURSIVE=1
export OPENREWARD_EXPECTED_PTC=1
export OPENREWARD_EXPECTED_EXPERIMENT_NAME=${EXPERIMENT}
export OPENREWARD_EXPECTED_TRIAL_NAME=${TRIAL}
export OPENREWARD_REQUIRE_EXISTING_RECOVERY=1
export OPENREWARD_EXPECTED_RESUME_GLOBAL_STEP=5
export OPENREWARD_EXPECTED_RESUME_CHECKPOINT_ROOT=${CHECKPOINT_ROOT}
export OPENREWARD_EXPECTED_RESUME_CHECKPOINT_LAYOUT_SHA256=6699027815f1628a6522c0520d3e30b17df124a41e3583b6ff4a3e4937b556f8
export OPENREWARD_EXPECTED_RESUME_CHECKPOINT_SAMPLE_MANIFEST_SHA256=23aea8bf8cc932936d250dd1646d191efe664047169445da1ce2ef67d7168e11
export OPENREWARD_EXPECTED_RESUME_FIXED_CONTENT_SHA256=ff7dccef8552800b23f1888cbf646c9b8f8c9019f5e83831264cd75ad6a15e6d
export OPENREWARD_EXPECTED_RESUME_RECOVER_INFO_CONTENT_SHA256=86e7b2726bcbc86328deb65dae0544c30afec2664d548b349aa87224626cfd3c
export OPENREWARD_EXPECTED_RESUME_DCP_STATE_KEYS=1472
export OPENREWARD_EXPECTED_RESUME_DCP_STORAGE_ENTRIES=18297
export OPENREWARD_EXPECTED_RESUME_DCP_SHARDS=160
export OPENREWARD_EXPECTED_RESUME_LR_NUM_STEPS=6
export OPENREWARD_EXPECTED_RESUME_SAMPLES_YIELDED=208
export OPENREWARD_EXPECTED_RESUME_ITERATOR_YIELDED=26
export PLATOON_TRAINING_SUCCESS_RECEIPT=${RECEIPT}
export PLATOON_TRAINING_SUCCESS_RECEIPT_REMOTE_TIMEOUT=300
export PLATOON_TRAINING_SUCCESS_RECEIPT_FINALIZE=0
export PLATOON_TRAINING_CONFIG_PATH=${CONFIG}
export PLATOON_TRAINING_SUCCESS_NOT_BEFORE_EPOCH=$(date +%s)
unset OPENREWARD_GATE_MARKER_TO_PUBLISH

exec "${COMMON}" "${CONFIG}"
