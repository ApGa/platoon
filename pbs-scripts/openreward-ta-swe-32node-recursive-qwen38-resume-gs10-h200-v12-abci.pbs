#!/bin/bash
#PBS -P gai51740
#PBS -q R9920261300
#PBS -v RTYPE=rt_HF
#PBS -l select=32:mpiprocs=8
#PBS -l place=scatter
#PBS -l walltime=168:00:00
#PBS -N rasp-h200-32q38-rs10-v22
#PBS -j oe
#PBS -o /groups/gai51740/aci18912it/rasp/logs/
#PBS -m a

# Exact ordinary-optimizer resume from the quiescent global-step-10 Qwen3.8
# recursive checkpoint.  The v8r22 runtime carries the corrected verifier
# subagent spawning implementation; the production rollout concurrency remains
# 24 with the exact v8r24 recursive-resume contract disabling the memory guard.

set -euo pipefail
umask 077

REPO_ROOT=/home/aci18912it/rasp/releases/platoon-v8r26-e11d720-057108f
RELEASE_REF=refs/tags/abci-v8r26-e11d720-057108f
RELEASE_VERIFY=${REPO_ROOT}/pbs-scripts/verify_openreward_v9_release.py
GATE2_VERIFY=${REPO_ROOT}/pbs-scripts/verify_openreward_v9_gate2_result.py
ALL_MCP_VERIFY=${REPO_ROOT}/pbs-scripts/verify_toolathlon_all_mcp_health_result.py
RESUME_VERIFY=${REPO_ROOT}/pbs-scripts/verify_openreward_resume_checkpoint.py
GATE2_RESULT=${OPENREWARD_V9_GATE2_RESULT:-}
ALL_MCP_RESULT=${OPENREWARD_TOOLATHLON_ALL_MCP_HEALTH_RESULT:-}
CONFIG=${REPO_ROOT}/plugins/openreward/platoon/openreward/configs/areal/abci_toolathlon_swe_openhands_areal_prealloc_32node_recursive_h200_qwen38_dense_c24_ta20_v22_resume_gs10.yaml
COMMON=${REPO_ROOT}/pbs-scripts/openreward-ta-swe-prealloc-common.sh
ABCI_ENV=${REPO_ROOT}/pbs-scripts/openreward-v9-abci.env
EXPERIMENT=abci-or-ta-swe32-q38-v16
TRIAL=abci-ta-swe32-rec-q38d-c24-v16-t0
CHECKPOINT_ROOT=/groups/gai51740/aci18912it/rasp/experiments/areal/checkpoints/aci18912it/${EXPERIMENT}/${TRIAL}
RECEIPT=/groups/gai51740/aci18912it/rasp/job-state/gates/${TRIAL}.resume-gs10-v8r22.success.json
SOURCE_CANDIDATE=/groups/gai51740/aci18912it/rasp/job-state/gates/${TRIAL}.resume-post-step6-v8r19.success.candidate.json
ANCESTOR_GS6=/groups/gai51740/aci18912it/rasp/job-state/gates/${TRIAL}.resume-gs5-v8r16.success.candidate.json
ANCESTOR_ORIGINAL=/groups/gai51740/aci18912it/rasp/job-state/gates/${TRIAL}.success.candidate.json
SOURCE_LOG=/groups/gai51740/aci18912it/rasp/logs/2159203.pbs1.OU
SOURCE_RELEASE_ROOT=/home/aci18912it/rasp/releases/platoon-v8r19-376d1b9-18e62c0
SOURCE_RELEASE_REF=refs/tags/abci-v8r19-376d1b9-18e62c0
SOURCE_CONFIG_RELATIVE=plugins/openreward/platoon/openreward/configs/areal/abci_toolathlon_swe_openhands_areal_prealloc_32node_recursive_h200_qwen38_dense_c24_ta20_v20.yaml
SOURCE_PBS_JOB_ID=2159203.pbs1
SUCCESSOR_BINDING=qwen38-32-v22-gs10
CURRENT_CONFIG_SHA256=578f64de97188829c84958f6aff785722ade4bf1571d9fdc93ac548944a54233
SOURCE_CONFIG_SHA256=24f6dc1c9ff7be36948dff1da59c8ded92d9f42d29ac9bf71fa3045f3fec8237
SOURCE_CANDIDATE_SHA256=4efedc4c9e86bf00cb6b1ed9f0881f44b13e19f792019160624c9520d685fa57
ANCESTOR_GS6_SHA256=12a5a385826dbb2efb4a6dbffcdc057dce7063def8ade0c0d131dae1f802cd94
ANCESTOR_ORIGINAL_SHA256=b432e3a12ff78921e7aac6cff3914f1c4c5aeffd9f08e3c9918ad5daa7714a22
SOURCE_LOG_SHA256=2021fe0893d707272736e87f243bb17510db9ee7bec104947f5d4053dcaa7322
EXPECTED_GLOBAL_STEP=10
EXPECTED_START_GLOBAL_STEP=11
EXPECTED_TOTAL_BYTES=383216730907
EXPECTED_CHECKPOINT_LAYOUT_SHA256=6699027815f1628a6522c0520d3e30b17df124a41e3583b6ff4a3e4937b556f8
EXPECTED_CHECKPOINT_SAMPLE_MANIFEST_SHA256=568a3fba94e9af17578de0550a0e86cacc9b4777f22d2e1bee4b4e6a9e369136
EXPECTED_FIXED_CONTENT_SHA256=fce62008329da13fb14e74be2c6117d94efb9789631764804aca74d871a5a997
EXPECTED_RECOVER_INFO_CONTENT_SHA256=cdc22676a6075771c319413fbec4bee2b3ac39bbf015782365cab882b8a7fa0e
EXPECTED_DCP_STATE_KEYS=1472
EXPECTED_DCP_STORAGE_ENTRIES=18297
EXPECTED_OPTIMIZER_MOMENT_KEYS=16
EXPECTED_LR_NUM_STEPS=11
EXPECTED_SAMPLES_YIELDED=512
EXPECTED_ITERATOR_YIELDED=64

die() {
    echo "[h200-32-q38-v22] ERROR: $*" >&2
    exit 2
}

[[ -d "${REPO_ROOT}/platoon" && -r "${CONFIG}" && -x "${COMMON}" && \
    -r "${ABCI_ENV}" && -x "${RELEASE_VERIFY}" && -x "${GATE2_VERIFY}" && \
    -x "${ALL_MCP_VERIFY}" && -x "${RESUME_VERIFY}" ]] ||
    die "immutable v8r22 release is incomplete: ${REPO_ROOT}"
[[ "$(readlink -f "${REPO_ROOT}")" == "${REPO_ROOT}" ]] ||
    die "release root must be the exact non-symlink path"
read -r observed_config_sha _ < <(sha256sum -- "${CONFIG}")
[[ "${observed_config_sha}" == "${CURRENT_CONFIG_SHA256}" ]] ||
    die "Qwen3.8 gs10 successor config digest mismatch"
unset observed_config_sha
for literal in \
    '  no_load_optim: false' \
    '  no_save_optim: false' \
    '    max_steps: 150' \
    '    timeout: 7200' \
    '    step_timeout: 5400' \
    '  max_concurrent_rollouts: 24' \
    '  request_timeout: 16200' \
    '    session_timeout_seconds: 9000' \
    '  subagent_default_max_steps: 100' \
    '  subagent_max_depth: 2' \
    '  subagent_reward_judge_max_steps: 100'; do
    [[ "$(grep -Fxc "${literal}" "${CONFIG}")" == 1 ]] ||
        die "Qwen3.8 gs10 successor lacks exact literal: ${literal}"
done

# shellcheck disable=SC1090
export OPENREWARD_MODEL_FAMILY=qwen38
source "${ABCI_ENV}"
export PLATOON_ABCI_ENV_FILE=${ABCI_ENV}
[[ "${PLATOON_REPO_ROOT}" == "${REPO_ROOT}" ]] ||
    die "v9 overlay selected another repository"
[[ "${OPENREWARD_QWEN38_MODEL_REPOSITORY:-}" == apurvaga/Qwen3.8-27B-preserve-thinking && \
    "${OPENREWARD_QWEN38_MODEL_REVISION:-}" == 97c725615b8aa025b800da4ceed38811358b30f1 && \
    "${OPENREWARD_QWEN38_MODEL_SNAPSHOT:-}" == /groups/gai51740/aci18912it/rasp/cache/huggingface/hub/models--apurvaga--Qwen3.8-27B-preserve-thinking/snapshots/97c725615b8aa025b800da4ceed38811358b30f1 && \
    -d "${OPENREWARD_QWEN38_MODEL_SNAPSHOT}" && ! -L "${OPENREWARD_QWEN38_MODEL_SNAPSHOT}" && \
    "$(readlink -f "${OPENREWARD_QWEN38_MODEL_SNAPSHOT}")" == "${OPENREWARD_QWEN38_MODEL_SNAPSHOT}" ]] ||
    die "pinned Qwen3.8 model binding is incomplete"
export PLATOON_MODEL_SNAPSHOT=${OPENREWARD_QWEN38_MODEL_SNAPSHOT}

"${RELEASE_VERIFY}" --release-root "${REPO_ROOT}"
[[ "${GATE2_RESULT}" == /* && -f "${GATE2_RESULT}" && ! -L "${GATE2_RESULT}" ]] ||
    die "submission must pass one absolute final v9 Gate2 RESULT"
"${GATE2_VERIFY}" --release-root "${REPO_ROOT}" --result "${GATE2_RESULT}"
[[ "${ALL_MCP_RESULT}" == /* && -f "${ALL_MCP_RESULT}" && ! -L "${ALL_MCP_RESULT}" ]] ||
    die "submission must pass one absolute final all-MCP RESULT"
"${ALL_MCP_VERIFY}" --release-root "${REPO_ROOT}" --result "${ALL_MCP_RESULT}" \
    --gate2-result "${GATE2_RESULT}"

"${RESUME_VERIFY}" \
    --checkpoint-root "${CHECKPOINT_ROOT}" \
    --expected-checkpoint-root "${CHECKPOINT_ROOT}" \
    --expected-global-step "${EXPECTED_GLOBAL_STEP}" \
    --expected-start-global-step "${EXPECTED_START_GLOBAL_STEP}" \
    --expected-steps-per-epoch 846 \
    --expected-shards 160 \
    --expected-total-bytes "${EXPECTED_TOTAL_BYTES}" \
    --expected-checkpoint-layout-sha256 "${EXPECTED_CHECKPOINT_LAYOUT_SHA256}" \
    --expected-checkpoint-sample-manifest-sha256 "${EXPECTED_CHECKPOINT_SAMPLE_MANIFEST_SHA256}" \
    --expected-fixed-content-sha256 "${EXPECTED_FIXED_CONTENT_SHA256}" \
    --expected-recover-info-content-sha256 "${EXPECTED_RECOVER_INFO_CONTENT_SHA256}" \
    --expected-experiment "${EXPERIMENT}" \
    --expected-trial "${TRIAL}" \
    --current-config "${CONFIG}" \
    --expected-config-sha256 "${CURRENT_CONFIG_SHA256}" \
    --expected-source-config-sha256 "${SOURCE_CONFIG_SHA256}" \
    --source-candidate "${SOURCE_CANDIDATE}" \
    --expected-source-candidate-sha256 "${SOURCE_CANDIDATE_SHA256}" \
    --authorized-ancestor-receipt "${ANCESTOR_GS6}" \
    --expected-authorized-ancestor-receipt-sha256 "${ANCESTOR_GS6_SHA256}" \
    --authorized-ancestor-receipt "${ANCESTOR_ORIGINAL}" \
    --expected-authorized-ancestor-receipt-sha256 "${ANCESTOR_ORIGINAL_SHA256}" \
    --source-log "${SOURCE_LOG}" \
    --expected-source-log-sha256 "${SOURCE_LOG_SHA256}" \
    --successor-binding "${SUCCESSOR_BINDING}" \
    --source-pbs-job-id "${SOURCE_PBS_JOB_ID}" \
    --source-release-root "${SOURCE_RELEASE_ROOT}" \
    --source-release-ref "${SOURCE_RELEASE_REF}" \
    --source-config-relative "${SOURCE_CONFIG_RELATIVE}" \
    --model-repository "${OPENREWARD_QWEN38_MODEL_REPOSITORY}" \
    --model-revision "${OPENREWARD_QWEN38_MODEL_REVISION}" \
    --model-snapshot "${OPENREWARD_QWEN38_MODEL_SNAPSHOT}" \
    --target-receipt "${RECEIPT}"

export OPENREWARD_EXPECTED_NNODES=32
export OPENREWARD_EXPECTED_MODEL_SHARDS=18
export OPENREWARD_SERVICE_NODE_COUNT=12
export OPENREWARD_EXPECTED_RECURSIVE=1
export OPENREWARD_EXPECTED_PTC=1
export OPENREWARD_EXPECTED_EXPERIMENT_NAME=${EXPERIMENT}
export OPENREWARD_EXPECTED_TRIAL_NAME=${TRIAL}
export OPENREWARD_REQUIRE_EXISTING_RECOVERY=1
export OPENREWARD_EXPECTED_RESUME_SUCCESSOR_BINDING=${SUCCESSOR_BINDING}
export OPENREWARD_EXPECTED_RESUME_GLOBAL_STEP=${EXPECTED_GLOBAL_STEP}
export OPENREWARD_EXPECTED_START_GLOBAL_STEP=${EXPECTED_START_GLOBAL_STEP}
export OPENREWARD_EXPECTED_RESUME_CHECKPOINT_ROOT=${CHECKPOINT_ROOT}
export OPENREWARD_EXPECTED_RESUME_CHECKPOINT_LAYOUT_SHA256=${EXPECTED_CHECKPOINT_LAYOUT_SHA256}
export OPENREWARD_EXPECTED_RESUME_CHECKPOINT_SAMPLE_MANIFEST_SHA256=${EXPECTED_CHECKPOINT_SAMPLE_MANIFEST_SHA256}
export OPENREWARD_EXPECTED_RESUME_FIXED_CONTENT_SHA256=${EXPECTED_FIXED_CONTENT_SHA256}
export OPENREWARD_EXPECTED_RESUME_RECOVER_INFO_CONTENT_SHA256=${EXPECTED_RECOVER_INFO_CONTENT_SHA256}
export OPENREWARD_EXPECTED_RESUME_DCP_STATE_KEYS=${EXPECTED_DCP_STATE_KEYS}
export OPENREWARD_EXPECTED_RESUME_DCP_STORAGE_ENTRIES=${EXPECTED_DCP_STORAGE_ENTRIES}
export OPENREWARD_EXPECTED_RESUME_DCP_SHARDS=160
export OPENREWARD_EXPECTED_RESUME_OPTIMIZER_MOMENT_KEYS=${EXPECTED_OPTIMIZER_MOMENT_KEYS}
export OPENREWARD_EXPECTED_RESUME_LR_NUM_STEPS=${EXPECTED_LR_NUM_STEPS}
export OPENREWARD_EXPECTED_RESUME_SAMPLES_YIELDED=${EXPECTED_SAMPLES_YIELDED}
export OPENREWARD_EXPECTED_RESUME_ITERATOR_YIELDED=${EXPECTED_ITERATOR_YIELDED}
export OPENREWARD_NODE_MEMORY_GUARD_ENABLED=0
export OPENREWARD_NODE_MEMORY_LIMIT_BYTES=2061584302080
export OPENREWARD_NODE_MEMORY_TRIGGER_PERCENT=85
export OPENREWARD_NODE_MEMORY_FALLBACK_AVAILABLE_BYTES=274877906944
export OPENREWARD_NODE_MEMORY_POLL_SECONDS=2
export OPENREWARD_NODE_MEMORY_TELEMETRY_SECONDS=60
export PLATOON_TRAINING_SUCCESS_RECEIPT=${RECEIPT}
export PLATOON_TRAINING_SUCCESS_RECEIPT_REMOTE_TIMEOUT=300
export PLATOON_TRAINING_SUCCESS_RECEIPT_FINALIZE=0
export PLATOON_TRAINING_CONFIG_PATH=${CONFIG}
export PLATOON_TRAINING_SUCCESS_NOT_BEFORE_EPOCH=$(date +%s)
unset OPENREWARD_GATE_MARKER_TO_PUBLISH
unset OPENREWARD_ALLOW_PREUPDATE_RESUME OPENREWARD_PREUPDATE_RESUME_BINDING
unset OPENREWARD_PREUPDATE_LOAD_POLICY OPENREWARD_PREUPDATE_NO_LOAD_OPTIM

exec "${COMMON}" "${CONFIG}"
