#!/usr/bin/env bash

set -euo pipefail

_OPENREWARD_V36_BASE_ENV=/home/aci18912it/rasp/releases/platoon-v8r33-07bebf9-057108f/pbs-scripts/openreward-v9-abci.env
[[ -r "${_OPENREWARD_V36_BASE_ENV}" ]] || {
