#!/bin/bash
#PBS -P gai51740
#PBS -q R9920261300
#PBS -v RTYPE=rt_HF
#PBS -l select=1:mpiprocs=8
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -N rasp-qwen35-sglang
#PBS -j oe
#PBS -o /groups/gai51740/aci18912it/rasp/logs/
#PBS -m a

# Offline one-node load/inference gate for the exact model, SIF, TP8 topology,
# context limit, and parsers inherited by the production AReaL rollout role.

set -euo pipefail
umask 077

source /etc/profile.d/modules.sh
module load singularity-ce/4.4.1

SIF=/groups/gai51740/aci18912it/rasp/images/platoon-training.sif
SIF_SHA=53c770558ad86e4a8ec4d2532cd3ba1c60a10bd75fff6a51049dfb411b002b12
MODEL=/groups/gai51740/aci18912it/rasp/cache/huggingface/hub/models--apurvaga--Qwen3.6-35B-A3B-preserve-thinking/snapshots/ce815485d640a33461c25e3d5c505b5346e8c857
LOCAL_ROOT=${PBS_LOCALDIR:?PBS_LOCALDIR is required}/qwen35-sglang-smoke
PORT=${QWEN35_SGLANG_SMOKE_PORT:-19000}
SERVER_LOG=${LOCAL_ROOT}/sglang.log
server_pid=

die() {
    echo "[qwen35-smoke] ERROR: $*" >&2
    exit 1
}

cleanup() {
    local status=$? deadline
    trap - EXIT INT TERM
    if [[ -n "${server_pid}" ]] && kill -0 "${server_pid}" 2>/dev/null; then
        kill -TERM -- "-${server_pid}" 2>/dev/null || true
        deadline=$((SECONDS + 45))
        while kill -0 "${server_pid}" 2>/dev/null && ((SECONDS < deadline)); do
            sleep 0.2
        done
        if kill -0 "${server_pid}" 2>/dev/null; then
            kill -KILL -- "-${server_pid}" 2>/dev/null || true
        fi
        wait "${server_pid}" 2>/dev/null || true
    fi
    if nvidia-smi --query-compute-apps=pid --format=csv,noheader,nounits 2>/dev/null | grep -q '[0-9]'; then
        echo "[qwen35-smoke] ERROR: GPU process survived server teardown" >&2
        status=1
    fi
    exit "${status}"
}

trap cleanup EXIT INT TERM

[[ "$(sha256sum "${SIF}" | awk '{print $1}')" == "${SIF_SHA}" ]] || \
    die "training SIF digest mismatch"
for file in config.json tokenizer.json tokenizer_config.json model.safetensors.index.json; do
    [[ -r "${MODEL}/${file}" ]] || die "model snapshot lacks ${file}"
done
[[ "$(find "${MODEL}" -maxdepth 1 -name 'model-*-of-*.safetensors' | wc -l)" -eq 26 ]] || \
    die "model snapshot does not contain all 26 shards"

mkdir -p "${LOCAL_ROOT}/tmp" "${LOCAL_ROOT}/home" "${LOCAL_ROOT}/cache"
chmod 0700 "${LOCAL_ROOT}" "${LOCAL_ROOT}/home" "${LOCAL_ROOT}/cache"
chmod 1777 "${LOCAL_ROOT}/tmp"

echo "[qwen35-smoke] starting exact offline TP8 model load sif_sha256=${SIF_SHA}"
mapfile -t GPU_UUIDS < <(nvidia-smi --query-gpu=uuid --format=csv,noheader | sed 's/[[:space:]]//g')
[[ "${#GPU_UUIDS[@]}" -eq 8 ]] || die "expected 8 H200 UUIDs, found ${#GPU_UUIDS[@]}"
NVIDIA_VISIBLE_DEVICES=$(IFS=,; printf '%s' "${GPU_UUIDS[*]}")
export NVIDIA_VISIBLE_DEVICES
setsid singularity exec --nv --cleanenv --containall --no-home \
    --no-mount home,cwd,bind-paths \
    --bind "/groups/gai51740/aci18912it/rasp:/groups/gai51740/aci18912it/rasp:ro" \
    --bind "${LOCAL_ROOT}/tmp:/tmp:rw" \
    --pwd /tmp \
    "${SIF}" \
    /usr/bin/env \
        HOME=/tmp/home \
        XDG_CACHE_HOME=/tmp/cache/xdg \
        FLASHINFER_CACHEDIR=/tmp/cache/flashinfer \
        TORCH_EXTENSIONS_DIR=/tmp/cache/torch-extensions \
        HF_HUB_OFFLINE=1 \
        TRANSFORMERS_OFFLINE=1 \
        CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7 \
        python3 -m sglang.launch_server \
            --model-path "${MODEL}" \
            --tokenizer-path "${MODEL}" \
            --host 127.0.0.1 \
            --port "${PORT}" \
            --tp-size 8 \
            --context-length 32769 \
            --mem-fraction-static 0.8 \
            --tool-call-parser qwen3_coder \
            --reasoning-parser qwen3 \
    >"${SERVER_LOG}" 2>&1 &
server_pid=$!

ready=0
deadline=$((SECONDS + 2400))
while ((SECONDS < deadline)); do
    if ! kill -0 "${server_pid}" 2>/dev/null; then
        tail -n 240 "${SERVER_LOG}" >&2 || true
        wait "${server_pid}" || true
        die "SGLang exited before readiness"
    fi
    status=$(curl --silent --output /dev/null --connect-timeout 2 --max-time 5 \
        --write-out '%{http_code}' --noproxy '*' "http://127.0.0.1:${PORT}/v1/models" || true)
    if [[ "${status}" == 200 ]]; then
        ready=1
        break
    fi
    sleep 5
done
((ready)) || {
    tail -n 240 "${SERVER_LOG}" >&2 || true
    die "SGLang did not become ready within 40 minutes"
}

python3 - "${PORT}" <<'PY'
import json
import sys
from urllib.request import Request, urlopen

port = int(sys.argv[1])
with urlopen(f"http://127.0.0.1:{port}/v1/models", timeout=30) as response:  # noqa: S310
    model_id = json.load(response)["data"][0]["id"]
payload = {
    "model": model_id,
    "messages": [
        {
            "role": "user",
            "content": "Use the add tool to compute 19 plus 23. Do not compute it yourself.",
        }
    ],
    "tools": [
        {
            "type": "function",
            "function": {
                "name": "add",
                "description": "Add two integers.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "a": {"type": "integer"},
                        "b": {"type": "integer"},
                    },
                    "required": ["a", "b"],
                },
            },
        }
    ],
    "tool_choice": {"type": "function", "function": {"name": "add"}},
    "temperature": 0,
    "max_tokens": 256,
}
request = Request(
    f"http://127.0.0.1:{port}/v1/chat/completions",
    data=json.dumps(payload).encode(),
    headers={"Content-Type": "application/json"},
    method="POST",
)
with urlopen(request, timeout=300) as response:  # noqa: S310 - localhost only
    result = json.load(response)
message = result["choices"][0]["message"]
tool_calls = message.get("tool_calls") or []
if not tool_calls:
    raise RuntimeError(f"Qwen/SGLang parser returned no tool call: {message}")
function = tool_calls[0].get("function", {})
if function.get("name") != "add":
    raise RuntimeError(f"unexpected tool call: {function}")
arguments = function.get("arguments", {})
if isinstance(arguments, str):
    arguments = json.loads(arguments)
if {int(arguments["a"]), int(arguments["b"])} != {19, 23}:
    raise RuntimeError(f"unexpected tool arguments: {arguments}")
print(
    json.dumps(
        {
            "qwen35_sglang_offline": "ok",
            "tool_name": function["name"],
            "finish_reason": result["choices"][0].get("finish_reason"),
        },
        sort_keys=True,
    )
)
PY

grep -Eq 'Qwen3_5MoeForConditionalGeneration|qwen3_5_moe' "${SERVER_LOG}" || \
    die "server log does not identify the expected Qwen3.5-MoE architecture"
echo "qwen35_sglang_offline_smoke=passed"
