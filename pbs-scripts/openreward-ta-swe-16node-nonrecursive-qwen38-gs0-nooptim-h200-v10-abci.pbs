#!/bin/bash
#PBS -P gai51740
#PBS -q R9920261300
#PBS -v RTYPE=rt_HF
#PBS -l select=16:mpiprocs=8
#PBS -l place=scatter
#PBS -l walltime=72:00:00
#PBS -N rasp-h200-16q38-rs0n-v20
#PBS -j oe
#PBS -o /groups/gai51740/aci18912it/rasp/logs/
#PBS -m a

# One-shot recovery of the exact pre-first-update Qwen3.8 16-node checkpoint
# produced by PBS job 2155389.pbs1. The frozen checkpoint has LR step 0 and no
# Adam moments, so this successor loads model state without optimizer state.
# Its first completed update still saves a normal optimizer-bearing checkpoint.
# Once global step advances beyond zero this wrapper fails closed; all later
# resumes must use the ordinary optimizer-loading configuration.

set -euo pipefail
umask 077

REPO_ROOT=/home/aci18912it/rasp/releases/platoon-v8r21-376d1b9-18e62c0
RELEASE_REF=refs/tags/abci-v8r21-376d1b9-18e62c0
RELEASE_VERIFY=${REPO_ROOT}/pbs-scripts/verify_openreward_v9_release.py
GATE2_VERIFY=${REPO_ROOT}/pbs-scripts/verify_openreward_v9_gate2_result.py
ALL_MCP_VERIFY=${REPO_ROOT}/pbs-scripts/verify_toolathlon_all_mcp_health_result.py
RESUME_VERIFY=${REPO_ROOT}/pbs-scripts/verify_openreward_resume_checkpoint.py
GATE2_RESULT=${OPENREWARD_V9_GATE2_RESULT:-}
ALL_MCP_RESULT=${OPENREWARD_TOOLATHLON_ALL_MCP_HEALTH_RESULT:-}
CONFIG=${REPO_ROOT}/plugins/openreward/platoon/openreward/configs/areal/abci_toolathlon_swe_openhands_areal_prealloc_16node_nonrecursive_h200_qwen38_dense_c12_ta20_v20_gs0_no_load_optim.yaml
COMMON=${REPO_ROOT}/pbs-scripts/openreward-ta-swe-prealloc-common.sh
ABCI_ENV=${REPO_ROOT}/pbs-scripts/openreward-v9-abci.env
EXPERIMENT=abci-or-ta-swe16-q38-v18
TRIAL=abci-ta-swe16-nr-q38d-c12-v18-t0
RECEIPT=/groups/gai51740/aci18912it/rasp/job-state/gates/${TRIAL}.resume-gs0-nooptim-v8r20.success.json
CHECKPOINT_ROOT=/groups/gai51740/aci18912it/rasp/experiments/areal/checkpoints/aci18912it/abci-or-ta-swe16-q38-v18/abci-ta-swe16-nr-q38d-c12-v18-t0
SOURCE_LOG=/groups/gai51740/aci18912it/rasp/logs/2155389.pbs1.OU
SOURCE_RELEASE_ROOT=/home/aci18912it/rasp/releases/platoon-v8r15-376d1b9-18e62c0
SOURCE_RELEASE_REF=refs/tags/abci-v8r15-376d1b9-18e62c0
SOURCE_CONFIG_RELATIVE=plugins/openreward/platoon/openreward/configs/areal/abci_toolathlon_swe_openhands_areal_prealloc_16node_nonrecursive_h200_qwen38_dense_c12_ta20_v18.yaml
SOURCE_CONFIG_SHA256=0ff5430c6be22ff8419af655243ed005757880bcafa61e40381175fa3bc6ab39
CURRENT_CONFIG_SHA256=efe71fd7616310aa7822f199600cf10f92e6cfdace31398d4e12c49084e61d97
PREUPDATE_BINDING=qwen38-16-v18-job2155389
PREUPDATE_LOAD_POLICY=qwen38-16-v20-gs0-no-load-optim
BINDING_STATE=FROZEN_GS0_PRISTINE_OPTIMIZER

die() {
    echo "[h200-16-q38-v20] ERROR: $*" >&2
    exit 2
}

[[ "${BINDING_STATE}" == FROZEN_GS0_PRISTINE_OPTIMIZER ]] ||
    die "step-zero recovery binding is not frozen"
[[ -d "${REPO_ROOT}/platoon" && -r "${CONFIG}" && -x "${COMMON}" && \
    -r "${ABCI_ENV}" && -x "${RELEASE_VERIFY}" && -x "${GATE2_VERIFY}" && \
    -x "${ALL_MCP_VERIFY}" && -x "${RESUME_VERIFY}" ]] ||
    die "immutable v8r21 release is incomplete: ${REPO_ROOT}"
[[ "$(readlink -f "${REPO_ROOT}")" == "${REPO_ROOT}" ]] ||
    die "release root must be the exact non-symlink path"

read -r observed_config_sha _ < <(sha256sum -- "${CONFIG}")
[[ "${observed_config_sha}" == "${CURRENT_CONFIG_SHA256}" ]] ||
    die "Qwen3.8 step-zero no-load-optimizer config digest mismatch"
unset observed_config_sha
for literal in \
    '  no_load_optim: true' \
    '  no_save_optim: false' \
    '  backend: megatron:d10p2t4c1' \
    '  backend: sglang:d6p1t8' \
    '  enable_recursive_subagents: false' \
    '  enable_programmatic_tool_calling: false'; do
    [[ "$(grep -Fxc "${literal}" "${CONFIG}")" == 1 ]] ||
        die "step-zero recovery leaf lacks exact literal: ${literal}"
done

[[ "${PREUPDATE_BINDING}" == qwen38-16-v18-job2155389 && \
    "${PREUPDATE_LOAD_POLICY}" == qwen38-16-v20-gs0-no-load-optim ]] ||
    die "step-zero source/load-policy binding changed"

# shellcheck disable=SC1090
export OPENREWARD_MODEL_FAMILY=qwen38
source "${ABCI_ENV}"
export PLATOON_ABCI_ENV_FILE=${ABCI_ENV}
[[ "${PLATOON_REPO_ROOT}" == "${REPO_ROOT}" ]] ||
    die "v9 overlay selected another repository"
[[ "${OPENREWARD_QWEN38_MODEL_REPOSITORY:-}" == apurvaga/Qwen3.8-27B-preserve-thinking && \
    "${OPENREWARD_QWEN38_MODEL_REVISION:-}" == 97c725615b8aa025b800da4ceed38811358b30f1 && \
    "${OPENREWARD_QWEN38_UPSTREAM_SOURCE:-}" == Qwen/Qwen3.8-27B@1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0 && \
    "${OPENREWARD_QWEN38_MODEL_SNAPSHOT:-}" == /groups/gai51740/aci18912it/rasp/cache/huggingface/hub/models--apurvaga--Qwen3.8-27B-preserve-thinking/snapshots/97c725615b8aa025b800da4ceed38811358b30f1 && \
    -d "${OPENREWARD_QWEN38_MODEL_SNAPSHOT}" && ! -L "${OPENREWARD_QWEN38_MODEL_SNAPSHOT}" && \
    "$(readlink -f "${OPENREWARD_QWEN38_MODEL_SNAPSHOT}")" == "${OPENREWARD_QWEN38_MODEL_SNAPSHOT}" ]] ||
    die "v18 Qwen3.8 preserve-thinking model binding is incomplete"
export PLATOON_MODEL_SNAPSHOT=${OPENREWARD_QWEN38_MODEL_SNAPSHOT}
export OPENREWARD_EXPECTED_TORCH_NCCL_HEARTBEAT_TIMEOUT_SEC=3600
export TORCH_NCCL_HEARTBEAT_TIMEOUT_SEC=${OPENREWARD_EXPECTED_TORCH_NCCL_HEARTBEAT_TIMEOUT_SEC}

"${RELEASE_VERIFY}" --release-root "${REPO_ROOT}"
[[ "${GATE2_RESULT}" == /* && -f "${GATE2_RESULT}" && ! -L "${GATE2_RESULT}" ]] ||
    die "submission must pass one absolute final v9 Gate2 RESULT"
"${GATE2_VERIFY}" --release-root "${REPO_ROOT}" --result "${GATE2_RESULT}"
[[ "${ALL_MCP_RESULT}" == /* && -f "${ALL_MCP_RESULT}" && ! -L "${ALL_MCP_RESULT}" ]] ||
    die "submission must pass one absolute final all-MCP RESULT"
"${ALL_MCP_VERIFY}" --release-root "${REPO_ROOT}" --result "${ALL_MCP_RESULT}" \
    --gate2-result "${GATE2_RESULT}"

"${RESUME_VERIFY}" \
    --checkpoint-root "${CHECKPOINT_ROOT}" \
    --expected-checkpoint-root "${CHECKPOINT_ROOT}" \
    --expected-global-step 0 \
    --expected-start-global-step 1 \
    --expected-steps-per-epoch 846 \
    --expected-shards 80 \
    --expected-total-bytes 164220069555 \
    --expected-checkpoint-layout-sha256 25af0d65a233ee77165489dad0c4bbe43a0a56b6745aa9785eddb23f5b720d0c \
    --expected-checkpoint-sample-manifest-sha256 3ab2c47cbe8b1d95f1c13ce09d026c57da8752db14749e0ce4011a762dd9505e \
    --expected-fixed-content-sha256 bb5ec86330f5acfdae93b04e6101d88a7244e702fcda812ccc0a97adcc6bf6da \
    --expected-recover-info-content-sha256 bfb4e310dc3f28946bd86b437cd8d0267875fd07a627346b151811ab83fd2bdb \
    --expected-experiment "${EXPERIMENT}" \
    --expected-trial "${TRIAL}" \
    --current-config "${CONFIG}" \
    --expected-config-sha256 "${CURRENT_CONFIG_SHA256}" \
    --expected-source-config-sha256 "${SOURCE_CONFIG_SHA256}" \
    --source-log "${SOURCE_LOG}" \
    --expected-source-log-sha256 2497762da279fd93486521b9bf8dad78c02d0fc0bec8f39e7172d188cbcdd552 \
    --allow-preupdate-global-step-zero \
    --preupdate-binding "${PREUPDATE_BINDING}" \
    --preupdate-load-policy "${PREUPDATE_LOAD_POLICY}" \
    --source-pbs-job-id 2155389.pbs1 \
    --source-release-root "${SOURCE_RELEASE_ROOT}" \
    --source-release-ref "${SOURCE_RELEASE_REF}" \
    --source-config-relative "${SOURCE_CONFIG_RELATIVE}" \
    --model-repository "${OPENREWARD_QWEN38_MODEL_REPOSITORY}" \
    --model-revision "${OPENREWARD_QWEN38_MODEL_REVISION}" \
    --model-snapshot "${OPENREWARD_QWEN38_MODEL_SNAPSHOT}" \
    --target-receipt "${RECEIPT}"
echo "[h200-16-q38-v20] authorized one-shot recovery checkpoint=${CHECKPOINT_ROOT} global_step=0 start_global_step=1"

export OPENREWARD_EXPECTED_NNODES=16
export OPENREWARD_EXPECTED_MODEL_SHARDS=18
export OPENREWARD_SERVICE_NODE_COUNT=6
export OPENREWARD_EXPECTED_RECURSIVE=0
export OPENREWARD_EXPECTED_PTC=0
export OPENREWARD_EXPECTED_EXPERIMENT_NAME=${EXPERIMENT}
export OPENREWARD_EXPECTED_TRIAL_NAME=${TRIAL}
export OPENREWARD_REQUIRE_EXISTING_RECOVERY=1
export OPENREWARD_ALLOW_PREUPDATE_RESUME=1
export OPENREWARD_PREUPDATE_RESUME_BINDING=${PREUPDATE_BINDING}
export OPENREWARD_PREUPDATE_LOAD_POLICY=${PREUPDATE_LOAD_POLICY}
export OPENREWARD_PREUPDATE_NO_LOAD_OPTIM=1
export OPENREWARD_EXPECTED_RESUME_GLOBAL_STEP=0
export OPENREWARD_EXPECTED_START_GLOBAL_STEP=1
export OPENREWARD_EXPECTED_RESUME_CHECKPOINT_ROOT=${CHECKPOINT_ROOT}
export OPENREWARD_EXPECTED_RESUME_CHECKPOINT_LAYOUT_SHA256=25af0d65a233ee77165489dad0c4bbe43a0a56b6745aa9785eddb23f5b720d0c
export OPENREWARD_EXPECTED_RESUME_CHECKPOINT_SAMPLE_MANIFEST_SHA256=3ab2c47cbe8b1d95f1c13ce09d026c57da8752db14749e0ce4011a762dd9505e
export OPENREWARD_EXPECTED_RESUME_FIXED_CONTENT_SHA256=bb5ec86330f5acfdae93b04e6101d88a7244e702fcda812ccc0a97adcc6bf6da
export OPENREWARD_EXPECTED_RESUME_RECOVER_INFO_CONTENT_SHA256=bfb4e310dc3f28946bd86b437cd8d0267875fd07a627346b151811ab83fd2bdb
export OPENREWARD_EXPECTED_RESUME_DCP_STATE_KEYS=1456
export OPENREWARD_EXPECTED_RESUME_DCP_STORAGE_ENTRIES=9169
export OPENREWARD_EXPECTED_RESUME_DCP_SHARDS=80
export OPENREWARD_EXPECTED_RESUME_OPTIMIZER_MOMENT_KEYS=0
export OPENREWARD_EXPECTED_RESUME_LR_NUM_STEPS=0
export OPENREWARD_EXPECTED_RESUME_SAMPLES_YIELDED=72
export OPENREWARD_EXPECTED_RESUME_ITERATOR_YIELDED=9
export PLATOON_TRAINING_SUCCESS_RECEIPT=${RECEIPT}
export PLATOON_TRAINING_SUCCESS_RECEIPT_REMOTE_TIMEOUT=300
export PLATOON_TRAINING_SUCCESS_RECEIPT_FINALIZE=0
export PLATOON_TRAINING_CONFIG_PATH=${CONFIG}
export PLATOON_TRAINING_SUCCESS_NOT_BEFORE_EPOCH=$(date +%s)
unset OPENREWARD_GATE_MARKER_TO_PUBLISH

exec "${COMMON}" "${CONFIG}"
