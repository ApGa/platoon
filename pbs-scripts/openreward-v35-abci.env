#!/usr/bin/env bash
# CP2 behavior/usage-gated v35 overlay. Reuse the accepted v34 model,
# container, environment, and partial-reward pins, then bind Python execution
# to the immutable v35 release.

set -euo pipefail

_OPENREWARD_V35_BASE_ENV=/home/aci18912it/rasp/releases/platoon-v8r33-07bebf9-057108f/pbs-scripts/openreward-v9-abci.env
[[ -r "${_OPENREWARD_V35_BASE_ENV}" ]] || {
    echo "[openreward-v35-env] ERROR: base v9 environment is unreadable" >&2
    return 2 2>/dev/null || exit 2
}
# shellcheck disable=SC1090
source "${_OPENREWARD_V35_BASE_ENV}"
export PLATOON_REPO_ROOT=/home/aci18912it/rasp/releases/platoon-v8r35-07bebf9-057108f
unset _OPENREWARD_V35_BASE_ENV
