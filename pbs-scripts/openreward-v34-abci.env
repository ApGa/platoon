#!/usr/bin/env bash
# Optimized behavior/usage-gated v34 overlay. Reuse the accepted v33 model,
# container, environment, and partial-reward pins, then bind Python execution
# to the immutable v34 release.

set -euo pipefail

_OPENREWARD_V34_BASE_ENV=/home/aci18912it/rasp/releases/platoon-v8r33-07bebf9-057108f/pbs-scripts/openreward-v9-abci.env
[[ -r "${_OPENREWARD_V34_BASE_ENV}" ]] || {
    echo "[openreward-v34-env] ERROR: base v9 environment is unreadable" >&2
    return 2 2>/dev/null || exit 2
}
# shellcheck disable=SC1090
source "${_OPENREWARD_V34_BASE_ENV}"
export PLATOON_REPO_ROOT=/home/aci18912it/rasp/releases/platoon-v8r34-07bebf9-057108f
unset _OPENREWARD_V34_BASE_ENV
