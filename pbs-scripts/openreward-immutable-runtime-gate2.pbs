gate2=passed
pbs_job_id=${PBS_JOBID}
worker_environment_key=${OPENREWARD_ENV_KEY}
controller_environment_key=${OPENREWARD_CONTROLLER_ENV_KEY}
source_sha256=${OPENREWARD_SOURCE_SHA}
training_sif_sha256=${actual_sif_sha}
worker_venv=${OPENREWARD_JOB_VENV}
controller_venv=${OPENREWARD_CONTROLLER_JOB_VENV}
EOF
chmod 0400 "${GATE_ROOT}/RESULT"
echo "gate2_immutable_runtime=passed result=${GATE_ROOT}/RESULT"
