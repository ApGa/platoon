#!/bin/bash
#PBS -P gai51740
#PBS -q R9920261300
#PBS -v RTYPE=rt_HF
#PBS -l select=32:mpiprocs=8
#PBS -l place=scatter
#PBS -l walltime=168:00:00
#PBS -N rasp-h200-32q36-bg-rs13-v31
#PBS -j oe
#PBS -o /groups/gai51740/aci18912it/rasp/logs/
#PBS -m a

# Exact optimizer-state resume of behavior-gated job 2191661 from its durable
# global-step-13 checkpoint.  The experiment/trial/W&B lineage is preserved.
# External Gate2 and all-MCP probes are intentionally not repeated here.

set -euo pipefail
umask 077

REPO_ROOT=/home/aci18912it/rasp/releases/platoon-v8r31-07bebf9-057108f
RELEASE_REF=refs/tags/abci-v8r31-07bebf9-057108f
RELEASE_VERIFY=${REPO_ROOT}/pbs-scripts/verify_openreward_v9_release.py
RESUME_VERIFY=${REPO_ROOT}/pbs-scripts/verify_openreward_resume_checkpoint.py
CONFIG=${REPO_ROOT}/plugins/openreward/platoon/openreward/configs/areal/abci_toolathlon_openhands_areal_prealloc_32node_recursive_h200_qwen36_moe_cp2_c12_v27_behavior_gated.yaml
COMMON=${REPO_ROOT}/pbs-scripts/openreward-ta-swe-prealloc-common.sh
ABCI_ENV=${REPO_ROOT}/pbs-scripts/openreward-v9-abci.env
EXPERIMENT=abci-or-ta32-q36-cp2-behavior-gate-v27
TRIAL=abci-ta32-rec-q36m-cp2-c12-d2-behavior-gate-v27-t0
CHECKPOINT_ROOT=/groups/gai51740/aci18912it/rasp/experiments/areal/checkpoints/aci18912it/${EXPERIMENT}/${TRIAL}
SOURCE_CANDIDATE=/groups/gai51740/aci18912it/rasp/job-state/gates/${TRIAL}.success.candidate.json
SOURCE_LOG=/groups/gai51740/aci18912it/rasp/logs/2191661.pbs1.OU
SOURCE_RELEASE_ROOT=/home/aci18912it/rasp/releases/platoon-v8r28-07bebf9-057108f
SOURCE_RELEASE_REF=refs/tags/abci-v8r28-07bebf9-057108f
SOURCE_CONFIG_RELATIVE=plugins/openreward/platoon/openreward/configs/areal/abci_toolathlon_openhands_areal_prealloc_32node_recursive_h200_qwen36_moe_cp2_c12_v27_behavior_gated.yaml
SOURCE_PBS_JOB_ID=2191661.pbs1
SUCCESSOR_BINDING=qwen36-32-v31-behavior-gs13
RECEIPT=/groups/gai51740/aci18912it/rasp/job-state/gates/${TRIAL}.resume-gs13-v8r31.success.json
CONFIG_SHA256=0b9aa3c482e73cc73661272325797cdd071b260ef4d2bd1d40fbc7abae5a46f1
SOURCE_CANDIDATE_SHA256=89ff453445edffc6ee7ed9de98cfa4db9b42220050b7c21e29d347508b11d1f0
SOURCE_LOG_SHA256=62d5950b0c226162a2ffcb02bdd7a9c999805f8db8488f517126bb0c32ae776b
EXPECTED_GLOBAL_STEP=13
EXPECTED_START_GLOBAL_STEP=14
EXPECTED_TOTAL_BYTES=492651122403
EXPECTED_CHECKPOINT_LAYOUT_SHA256=c81e27a8a3c2bc65dd24b74a1d6271aefa8d56ee250e54731890367477b1ead6
EXPECTED_CHECKPOINT_SAMPLE_MANIFEST_SHA256=ac9516d2fa09a35885ead1fe05bc5108f7dd0e54645959c8ed957f103b10d597
EXPECTED_FIXED_CONTENT_SHA256=846524d1d26c8ba0184e99ea0d6cdb63812201926f75ea007311500c7e4b6ba3
EXPECTED_RECOVER_INFO_CONTENT_SHA256=f126b8c0b3657d22ca9e8f44cc94f9a72fa9ea51d571a3c0c683e3b1260164fc
EXPECTED_DCP_STATE_KEYS=21768
EXPECTED_DCP_STORAGE_ENTRIES=127481
EXPECTED_OPTIMIZER_MOMENT_KEYS=48
EXPECTED_LR_NUM_STEPS=14
EXPECTED_SAMPLES_YIELDED=152
EXPECTED_ITERATOR_YIELDED=19

die() {
    echo "[h200-32-q36-behavior-resume-v31] ERROR: $*" >&2
    exit 2
}

[[ -d "${REPO_ROOT}/platoon" && -d "${REPO_ROOT}/external/AReaL" && \
    -r "${CONFIG}" && -x "${COMMON}" && -r "${ABCI_ENV}" && \
    -x "${RELEASE_VERIFY}" && -x "${RESUME_VERIFY}" ]] || \
    die "immutable v8r31 release is incomplete: ${REPO_ROOT}"
[[ "$(readlink -f "${REPO_ROOT}")" == "${REPO_ROOT}" ]] || \
    die "release root must be the exact non-symlink path"
read -r observed_config_sha _ < <(sha256sum -- "${CONFIG}")
[[ "${observed_config_sha}" == "${CONFIG_SHA256}" ]] || \
    die "behavior-gated config digest mismatch"
unset observed_config_sha

release_head=$(git -C "${REPO_ROOT}" rev-parse --verify HEAD)
release_commit=$(git -C "${REPO_ROOT}" rev-parse --verify "${RELEASE_REF}^{commit}")
[[ "${release_head}" == "${release_commit}" ]] || die "release HEAD is not ${RELEASE_REF}"
git -C "${REPO_ROOT}" diff --quiet --no-ext-diff HEAD -- || die "release tracked tree is dirty"
git -C "${REPO_ROOT}" diff --cached --quiet --no-ext-diff HEAD -- || die "release index is dirty"
[[ -z "$(git -C "${REPO_ROOT}" status --porcelain=v1 --untracked-files=all)" ]] || \
    die "release has tracked or ordinary untracked changes"
unset release_head release_commit

# shellcheck disable=SC1090
export OPENREWARD_MODEL_FAMILY=qwen36
source "${ABCI_ENV}"
export PLATOON_ABCI_ENV_FILE=${ABCI_ENV}
[[ "${PLATOON_REPO_ROOT}" == "${REPO_ROOT}" ]] || die "v31 overlay selected another repository"
[[ "${OPENREWARD_QWEN36_MODEL_REPOSITORY:-}" == apurvaga/Qwen3.6-35B-A3B-preserve-thinking && \
    "${OPENREWARD_QWEN36_MODEL_REVISION:-}" == ce815485d640a33461c25e3d5c505b5346e8c857 && \
    "${OPENREWARD_QWEN36_MODEL_SNAPSHOT:-}" == /groups/gai51740/aci18912it/rasp/cache/huggingface/hub/models--apurvaga--Qwen3.6-35B-A3B-preserve-thinking/snapshots/ce815485d640a33461c25e3d5c505b5346e8c857 && \
    -d "${OPENREWARD_QWEN36_MODEL_SNAPSHOT}" && ! -L "${OPENREWARD_QWEN36_MODEL_SNAPSHOT}" ]] || \
    die "pinned Qwen3.6 preserve-thinking model binding is incomplete"
export PLATOON_MODEL_SNAPSHOT=${OPENREWARD_QWEN36_MODEL_SNAPSHOT}

"${RELEASE_VERIFY}" --release-root "${REPO_ROOT}"
"${RESUME_VERIFY}" \
    --checkpoint-root "${CHECKPOINT_ROOT}" \
    --expected-checkpoint-root "${CHECKPOINT_ROOT}" \
    --expected-global-step "${EXPECTED_GLOBAL_STEP}" \
    --expected-start-global-step "${EXPECTED_START_GLOBAL_STEP}" \
    --expected-steps-per-epoch 62 \
    --expected-shards 160 \
    --expected-total-bytes "${EXPECTED_TOTAL_BYTES}" \
    --expected-checkpoint-layout-sha256 "${EXPECTED_CHECKPOINT_LAYOUT_SHA256}" \
    --expected-checkpoint-sample-manifest-sha256 "${EXPECTED_CHECKPOINT_SAMPLE_MANIFEST_SHA256}" \
    --expected-fixed-content-sha256 "${EXPECTED_FIXED_CONTENT_SHA256}" \
    --expected-recover-info-content-sha256 "${EXPECTED_RECOVER_INFO_CONTENT_SHA256}" \
    --expected-experiment "${EXPERIMENT}" \
    --expected-trial "${TRIAL}" \
    --current-config "${CONFIG}" \
    --expected-config-sha256 "${CONFIG_SHA256}" \
    --expected-source-config-sha256 "${CONFIG_SHA256}" \
    --source-candidate "${SOURCE_CANDIDATE}" \
    --expected-source-candidate-sha256 "${SOURCE_CANDIDATE_SHA256}" \
    --source-log "${SOURCE_LOG}" \
    --expected-source-log-sha256 "${SOURCE_LOG_SHA256}" \
    --successor-binding "${SUCCESSOR_BINDING}" \
    --source-pbs-job-id "${SOURCE_PBS_JOB_ID}" \
    --source-release-root "${SOURCE_RELEASE_ROOT}" \
    --source-release-ref "${SOURCE_RELEASE_REF}" \
    --source-config-relative "${SOURCE_CONFIG_RELATIVE}" \
    --model-repository "${OPENREWARD_QWEN36_MODEL_REPOSITORY}" \
    --model-revision "${OPENREWARD_QWEN36_MODEL_REVISION}" \
    --model-snapshot "${OPENREWARD_QWEN36_MODEL_SNAPSHOT}" \
    --target-receipt "${RECEIPT}"

export OPENREWARD_EXPECTED_NNODES=32
export OPENREWARD_EXPECTED_MODEL_SHARDS=26
export OPENREWARD_SERVICE_NODE_COUNT=12
export OPENREWARD_ENVIRONMENT_SET=toolathlon_only
export OPENREWARD_EXPECTED_RECURSIVE=1
export OPENREWARD_EXPECTED_PTC=1
export OPENREWARD_EXPECTED_EXPERIMENT_NAME=${EXPERIMENT}
export OPENREWARD_EXPECTED_TRIAL_NAME=${TRIAL}
export OPENREWARD_REQUIRE_EXISTING_RECOVERY=1
export OPENREWARD_EXPECTED_RESUME_SUCCESSOR_BINDING=${SUCCESSOR_BINDING}
export OPENREWARD_EXPECTED_RESUME_GLOBAL_STEP=${EXPECTED_GLOBAL_STEP}
export OPENREWARD_EXPECTED_START_GLOBAL_STEP=${EXPECTED_START_GLOBAL_STEP}
export OPENREWARD_EXPECTED_RESUME_CHECKPOINT_ROOT=${CHECKPOINT_ROOT}
export OPENREWARD_EXPECTED_RESUME_CHECKPOINT_LAYOUT_SHA256=${EXPECTED_CHECKPOINT_LAYOUT_SHA256}
export OPENREWARD_EXPECTED_RESUME_CHECKPOINT_SAMPLE_MANIFEST_SHA256=${EXPECTED_CHECKPOINT_SAMPLE_MANIFEST_SHA256}
export OPENREWARD_EXPECTED_RESUME_FIXED_CONTENT_SHA256=${EXPECTED_FIXED_CONTENT_SHA256}
export OPENREWARD_EXPECTED_RESUME_RECOVER_INFO_CONTENT_SHA256=${EXPECTED_RECOVER_INFO_CONTENT_SHA256}
export OPENREWARD_EXPECTED_RESUME_DCP_STATE_KEYS=${EXPECTED_DCP_STATE_KEYS}
export OPENREWARD_EXPECTED_RESUME_DCP_STORAGE_ENTRIES=${EXPECTED_DCP_STORAGE_ENTRIES}
export OPENREWARD_EXPECTED_RESUME_DCP_SHARDS=160
export OPENREWARD_EXPECTED_RESUME_OPTIMIZER_MOMENT_KEYS=${EXPECTED_OPTIMIZER_MOMENT_KEYS}
export OPENREWARD_EXPECTED_RESUME_LR_NUM_STEPS=${EXPECTED_LR_NUM_STEPS}
export OPENREWARD_EXPECTED_RESUME_SAMPLES_YIELDED=${EXPECTED_SAMPLES_YIELDED}
export OPENREWARD_EXPECTED_RESUME_ITERATOR_YIELDED=${EXPECTED_ITERATOR_YIELDED}
export OPENREWARD_NODE_MEMORY_GUARD_ENABLED=0
export OPENREWARD_NODE_MEMORY_LIMIT_BYTES=2061584302080
export OPENREWARD_NODE_MEMORY_TRIGGER_PERCENT=85
export OPENREWARD_NODE_MEMORY_FALLBACK_AVAILABLE_BYTES=274877906944
export OPENREWARD_NODE_MEMORY_POLL_SECONDS=2
export OPENREWARD_NODE_MEMORY_TELEMETRY_SECONDS=60
export PLATOON_TRAINING_SUCCESS_RECEIPT=${RECEIPT}
export PLATOON_TRAINING_SUCCESS_RECEIPT_REMOTE_TIMEOUT=300
export PLATOON_TRAINING_SUCCESS_RECEIPT_FINALIZE=0
export PLATOON_TRAINING_CONFIG_PATH=${CONFIG}
export PLATOON_TRAINING_SUCCESS_NOT_BEFORE_EPOCH=$(date +%s)
unset OPENREWARD_GATE_MARKER_TO_PUBLISH OPENREWARD_EXPECTED_FRESH_RUN_BINDING
unset OPENREWARD_ALLOW_PREUPDATE_RESUME OPENREWARD_PREUPDATE_RESUME_BINDING
unset OPENREWARD_PREUPDATE_LOAD_POLICY OPENREWARD_PREUPDATE_NO_LOAD_OPTIM

exec "${COMMON}" "${CONFIG}"
