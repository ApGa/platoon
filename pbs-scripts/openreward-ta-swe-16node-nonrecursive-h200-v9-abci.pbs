#!/bin/bash
#PBS -P gai51740
#PBS -q R9920261300
#PBS -v RTYPE=rt_HF
#PBS -l select=16:mpiprocs=8
#PBS -l place=scatter
#PBS -l walltime=168:00:00
#PBS -N rasp-h200-16q38-v18
#PBS -j oe
#PBS -o /groups/gai51740/aci18912it/rasp/logs/
#PBS -m a

# Fresh dense-Qwen3.8 nonrecursive replacement for the v9 16-node job. This launcher is
# intentionally unusable until the immutable v8r15 release, v9 overlay, release
# verifier, and PBS all-MCP health gate have been materialized and approved.
# It retains the full ten-epoch/no-step-cap horizon and keeps PTC disabled.
# Submitters must pass both immutable-runtime and post-F MCP acceptances as
# OPENREWARD_V9_GATE2_RESULT=/absolute/path/to/RESULT and
# OPENREWARD_TOOLATHLON_ALL_MCP_HEALTH_RESULT=/absolute/path/to/RESULT.

set -euo pipefail
umask 077

REPO_ROOT=/home/aci18912it/rasp/releases/platoon-v8r15-376d1b9-18e62c0
RELEASE_REF=refs/tags/abci-v8r15-376d1b9-18e62c0
RELEASE_VERIFY=${REPO_ROOT}/pbs-scripts/verify_openreward_v9_release.py
GATE2_VERIFY=${REPO_ROOT}/pbs-scripts/verify_openreward_v9_gate2_result.py
ALL_MCP_VERIFY=${REPO_ROOT}/pbs-scripts/verify_toolathlon_all_mcp_health_result.py
GATE2_RESULT=${OPENREWARD_V9_GATE2_RESULT:-}
ALL_MCP_RESULT=${OPENREWARD_TOOLATHLON_ALL_MCP_HEALTH_RESULT:-}
CONFIG=${REPO_ROOT}/plugins/openreward/platoon/openreward/configs/areal/abci_toolathlon_swe_openhands_areal_prealloc_16node_nonrecursive_h200_qwen38_dense_c12_ta20_v18.yaml
COMMON=${REPO_ROOT}/pbs-scripts/openreward-ta-swe-prealloc-common.sh
ABCI_ENV=${REPO_ROOT}/pbs-scripts/openreward-v9-abci.env
EXPERIMENT=abci-or-ta-swe16-q38-v18
TRIAL=abci-ta-swe16-nr-q38d-c12-v18-t0
RECEIPT=/groups/gai51740/aci18912it/rasp/job-state/gates/${TRIAL}.success.json
CHECKPOINT_ROOT=/groups/gai51740/aci18912it/rasp/experiments/areal/checkpoints/$(id -un)/${EXPERIMENT}/${TRIAL}

[[ -d "${REPO_ROOT}/platoon" && -r "${CONFIG}" && -x "${COMMON}" && -r "${ABCI_ENV}" && \
    -x "${RELEASE_VERIFY}" && -x "${GATE2_VERIFY}" && -x "${ALL_MCP_VERIFY}" ]] || {
    echo "[h200-16-v9] ERROR: immutable v8r15 release is incomplete: ${REPO_ROOT}" >&2
    exit 2
}
[[ "$(grep -Fxc '  dynamic_batch_recollection_max_rounds: 1' "${CONFIG}")" == 1 && \
    "$(grep -Fxc '  consumer_batch_size: 8' "${CONFIG}")" == 1 && \
    "$(grep -Fxc '  max_head_offpolicyness: 1' "${CONFIG}")" == 1 && \
    "$(grep -Fxc '  backend: megatron:d10p2t4c1' "${CONFIG}")" == 1 && \
    "$(grep -Fxc '  backend: sglang:d6p1t8' "${CONFIG}")" == 1 && \
    "$(grep -Fxc '    n_mbs: 8' "${CONFIG}")" == 1 && \
    "$(grep -Fxc '  return_routed_experts: false' "${CONFIG}")" == 1 && \
    "$(grep -Fxc '  enable_router_replay: false' "${CONFIG}")" == 2 && \
    "$(grep -Fxc '    use_deterministic_algorithms: false' "${CONFIG}")" == 1 ]] || {
    echo "[h200-16-v9] ERROR: dense leaf must pin d10p2t4c1/d6p1t8, n_mbs=8, recollection=1, consumer=8, staleness=1, R3 off, and deterministic algorithms off" >&2
    exit 2
}
[[ "$(readlink -f "${REPO_ROOT}")" == "${REPO_ROOT}" ]] || {
    echo "[h200-16-v9] ERROR: release root must be the exact non-symlink path: ${REPO_ROOT}" >&2
    exit 2
}
release_head=$(git -C "${REPO_ROOT}" rev-parse --verify HEAD)
release_commit=$(git -C "${REPO_ROOT}" rev-parse --verify "${RELEASE_REF}^{commit}")
[[ "${release_head}" == "${release_commit}" ]] || {
    echo "[h200-16-v9] ERROR: release HEAD is not the pinned ${RELEASE_REF}" >&2
    exit 2
}
git -C "${REPO_ROOT}" diff --quiet --no-ext-diff HEAD -- || {
    echo "[h200-16-v9] ERROR: release tracked content differs from ${release_commit}" >&2
    exit 2
}
git -C "${REPO_ROOT}" diff --cached --quiet --no-ext-diff HEAD -- || {
    echo "[h200-16-v9] ERROR: release index differs from ${release_commit}" >&2
    exit 2
}
[[ -z "$(git -C "${REPO_ROOT}" status --porcelain=v1 --untracked-files=all)" ]] || {
    echo "[h200-16-v9] ERROR: release has tracked or ordinary untracked changes" >&2
    exit 2
}
# The Gate2 verifier rehashes the currently selected training and Toolathlon
# images, so load the exact release overlay before either external gate.  The
# overlay is non-secret and delegates protected credentials to the canonical
# site environment without printing them.
# shellcheck disable=SC1090
source "${ABCI_ENV}"
export PLATOON_ABCI_ENV_FILE=${ABCI_ENV}
[[ "${PLATOON_REPO_ROOT}" == "${REPO_ROOT}" ]] || {
    echo "[h200-16-v9] ERROR: v9 overlay selected another repository" >&2
    exit 2
}
[[ "${OPENREWARD_QWEN38_MODEL_REPOSITORY:-}" == apurvaga/Qwen3.8-27B-preserve-thinking && \
    "${OPENREWARD_QWEN38_MODEL_REVISION:-}" == 97c725615b8aa025b800da4ceed38811358b30f1 && \
    "${OPENREWARD_QWEN38_UPSTREAM_SOURCE:-}" == Qwen/Qwen3.8-27B@1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0 && \
    "${OPENREWARD_QWEN38_MODEL_SNAPSHOT:-}" == /groups/gai51740/aci18912it/rasp/cache/huggingface/hub/models--apurvaga--Qwen3.8-27B-preserve-thinking/snapshots/97c725615b8aa025b800da4ceed38811358b30f1 && \
    -d "${OPENREWARD_QWEN38_MODEL_SNAPSHOT}" && ! -L "${OPENREWARD_QWEN38_MODEL_SNAPSHOT}" && \
    "$(readlink -f "${OPENREWARD_QWEN38_MODEL_SNAPSHOT}")" == "${OPENREWARD_QWEN38_MODEL_SNAPSHOT}" ]] || {
    echo "[h200-16-v9] ERROR: v18 Qwen3.8 preserve-thinking model binding is incomplete" >&2
    exit 2
}
export PLATOON_MODEL_SNAPSHOT=${OPENREWARD_QWEN38_MODEL_SNAPSHOT}
export OPENREWARD_EXPECTED_TORCH_NCCL_HEARTBEAT_TIMEOUT_SEC=3600
export TORCH_NCCL_HEARTBEAT_TIMEOUT_SEC=${OPENREWARD_EXPECTED_TORCH_NCCL_HEARTBEAT_TIMEOUT_SEC}
"${RELEASE_VERIFY}" --release-root "${REPO_ROOT}"
[[ "${GATE2_RESULT}" == /* && -f "${GATE2_RESULT}" && ! -L "${GATE2_RESULT}" ]] || {
    echo "[h200-16-v9] ERROR: submission must pass one absolute final v9 Gate2 RESULT" >&2
    exit 2
}
"${GATE2_VERIFY}" --release-root "${REPO_ROOT}" --result "${GATE2_RESULT}"
[[ "${ALL_MCP_RESULT}" == /* && -f "${ALL_MCP_RESULT}" && ! -L "${ALL_MCP_RESULT}" ]] || {
    echo "[h200-16-v9] ERROR: submission must pass one absolute final all-MCP RESULT" >&2
    exit 2
}
"${ALL_MCP_VERIFY}" --release-root "${REPO_ROOT}" --result "${ALL_MCP_RESULT}" \
    --gate2-result "${GATE2_RESULT}"
echo "[h200-16-v9] accepted gate2=${GATE2_RESULT} all-MCP=${ALL_MCP_RESULT}"
unset release_head release_commit

prior_receipts=("${RECEIPT}" "${RECEIPT%.json}.candidate.json" "${RECEIPT%.json}.error.json")
for prior in "${prior_receipts[@]}"; do
    [[ ! -e "${prior}" && ! -L "${prior}" ]] || {
        echo "[h200-16-v9] ERROR: refusing stale success artifact; use a fresh trial: ${prior}" >&2
        exit 2
    }
done
[[ ! -e "${CHECKPOINT_ROOT}" && ! -L "${CHECKPOINT_ROOT}" ]] || {
    echo "[h200-16-v9] ERROR: refusing stale checkpoint; this must remain a model-only lineage: ${CHECKPOINT_ROOT}" >&2
    exit 2
}

export OPENREWARD_EXPECTED_NNODES=16
export OPENREWARD_EXPECTED_MODEL_SHARDS=18
export OPENREWARD_SERVICE_NODE_COUNT=6
export OPENREWARD_EXPECTED_RECURSIVE=0
export OPENREWARD_EXPECTED_PTC=0
export OPENREWARD_EXPECTED_EXPERIMENT_NAME=${EXPERIMENT}
export OPENREWARD_EXPECTED_TRIAL_NAME=${TRIAL}
export PLATOON_TRAINING_SUCCESS_RECEIPT=${RECEIPT}
export PLATOON_TRAINING_SUCCESS_RECEIPT_REMOTE_TIMEOUT=300
export PLATOON_TRAINING_SUCCESS_RECEIPT_FINALIZE=0
export PLATOON_TRAINING_CONFIG_PATH=${CONFIG}
export PLATOON_TRAINING_SUCCESS_NOT_BEFORE_EPOCH=$(date +%s)
unset OPENREWARD_GATE_MARKER_TO_PUBLISH

exec "${COMMON}" "${CONFIG}"
