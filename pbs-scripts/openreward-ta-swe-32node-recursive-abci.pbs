#!/bin/bash
#PBS -P gai51740
#PBS -q R9920261300
#PBS -v RTYPE=rt_HF
#PBS -l select=32:mpiprocs=8
#PBS -l place=scatter
#PBS -l walltime=168:00:00
#PBS -N rasp-ta-swe32-rec
#PBS -j oe
#PBS -o /groups/gai51740/aci18912it/rasp/logs/
#PBS -m a

# Recursive scale-up.  This wrapper refuses to enter common lifecycle setup
# unless an atomic marker proves the designated 16-node nonrecursive trial has
# completed and checkpointed at least one optimizer update with the same SIF.

set -euo pipefail
umask 077

ABCI_ENV=/home/aci18912it/rasp/config/abci.env
# shellcheck disable=SC1090
source "${ABCI_ENV}"
source /etc/profile.d/modules.sh
module load singularity-ce/4.4.1

REPO_ROOT=${PLATOON_REPO_ROOT}
CONFIG=${REPO_ROOT}/plugins/openreward/platoon/openreward/configs/areal/abci_toolathlon_swe_openhands_areal_prealloc_32node_recursive_ta20.yaml
COMMON=${REPO_ROOT}/pbs-scripts/openreward-ta-swe-prealloc-common.sh
GATE_HELPER=${REPO_ROOT}/pbs-scripts/openreward_update_gate.py
GATE_MARKER=${PLATOON_JOB_STATE_ROOT}/gates/abci-ta-swe16-nonrecursive-update.json
GATE_EXPERIMENT=abci-openreward-ta-swe
GATE_TRIAL=abci-ta-swe16-nonrec-ta20-v1-trial0

[[ -r "${PLATOON_TRAINING_SIF}.sha256" ]] || {
    echo "ERROR: training SIF digest sidecar is missing: ${PLATOON_TRAINING_SIF}.sha256" >&2
    exit 2
}
expected_sha=$(awk 'NF {print $1; exit}' "${PLATOON_TRAINING_SIF}.sha256")
actual_sha=$(sha256sum "${PLATOON_TRAINING_SIF}" | awk '{print $1}')
[[ "${expected_sha}" == "${actual_sha}" ]] || {
    echo "ERROR: training SIF does not match its digest sidecar" >&2
    exit 2
}

"${GATE_HELPER}" verify \
    --marker "${GATE_MARKER}" \
    --fileroot "${PLATOON_EXPERIMENT_ROOT}" \
    --experiment "${GATE_EXPERIMENT}" \
    --trial "${GATE_TRIAL}" \
    --min-global-step 0 \
    --training-sif "${PLATOON_TRAINING_SIF}" \
    --training-sif-sha256 "${actual_sha}"

export OPENREWARD_EXPECTED_NNODES=32
export OPENREWARD_EXPECTED_RECURSIVE=1
export OPENREWARD_EXPECTED_EXPERIMENT_NAME=abci-openreward-ta-swe
export OPENREWARD_EXPECTED_TRIAL_NAME=abci-ta-swe32-rec-ta20-v1-trial0
unset OPENREWARD_GATE_MARKER_TO_PUBLISH

exec "${COMMON}" "${CONFIG}"
